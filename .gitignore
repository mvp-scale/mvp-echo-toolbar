# TypeScript build artifacts.
# `tsc -b` emits these because tsconfig.node.json has no `noEmit` — the
# typecheck script uses `--noEmit` to avoid producing them, but a stray
# `tsc -b` (from an IDE or by hand) still can. See _review/FIX-PLAN.md Fix 8.
*.tsbuildinfo
mvp-echo-toolbar/vite.config.js
mvp-echo-toolbar/vite.config.d.ts

# Byte-identical copy of app/preload/preload.js that the build emits at the
# project root. Nothing loads it; getPreloadPath() resolves ../preload/preload.js
# relative to app/main. Ignored so it can't be mistaken for the real file.
mvp-echo-toolbar/preload.js
